# Host user/group used for files created from the development container.
DOCKERCOMPOSE_UID=1001
DOCKERCOMPOSE_GID=1001

# UUID of the desktop RTX 5070 Ti. Using its UUID, rather than `gpus: all` or
# CUDA_VISIBLE_DEVICES, prevents the adjacent RTX 3060 entering the container.
NVIDIA_GPU_DEVICE_ID=GPU-b92dd589-9f59-c3ef-4104-b402606130d9

WEB_HOST_PORT=8082
TENSORBOARD_HOST_PORT=6007
