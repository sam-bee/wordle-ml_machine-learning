# Build the browser assets and Go web server in one image.
FROM node:22-bookworm AS frontend

WORKDIR /src/frontend
COPY web/frontend/package.json web/frontend/package-lock.json ./
RUN npm ci
COPY web/frontend/ ./
RUN npm run build

FROM golang:1.26-bookworm AS gobuild

WORKDIR /src
COPY web/go.mod web/go.sum ./
RUN go mod download
COPY web/ ./

# Replace the source placeholder with assets generated by Vite in the frontend stage.
RUN rm -rf internal/static/dist
COPY --from=frontend /src/frontend/dist ./internal/static/dist
RUN CGO_ENABLED=0 go build -o /out/web ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=gobuild /out/web /web
ENV WEB_ADDR=:8080
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/web"]
