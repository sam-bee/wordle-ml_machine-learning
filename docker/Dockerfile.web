# The splash page and Go server are built entirely inside this image.
FROM golang:1.26.5-bookworm AS build

WORKDIR /src
COPY web/go.mod web/go.sum* ./
RUN go mod download
COPY web/ ./
RUN go test ./... \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/wordleml-web ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/wordleml-web /wordleml-web
ENV WEB_ADDR=:8080
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/wordleml-web"]
